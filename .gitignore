# 虚拟环境（含绝对路径，不可移植，按 requirements.txt 重建）
.venv/

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# 工具内置工作区（临时脚本、备份、工作日志，仅本机留档，不入库）
.workbuddy/

# 文献残料（重名副本、格式转换中间件），正文引用的 PDF 照常入库
文献/_archive/

# 文档生成流水线的一次性中间产物（正式交付物在项目根目录）
output/

# 编辑器 / 系统杂项
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*
